# Copiați acest fișier în .env (cp .env.example .env sau, pe Windows, copy .env.example .env).
# Valorile de aici sunt doar pentru rularea locală. Nu puneți chei reale în .env.example.

# Portul serverului Express
PORT=3000

# Fișierul bazei de date SQLite (se creează automat)
DB_STORAGE=data/firecheck.sqlite

# 0 = dezactivează jurnalul de cereri
LOG_REQUESTS=1

# Serviciul extern „Registrul PSI” (simulatorul local din registry-sim/)
REGISTRY_URL=http://localhost:4000
REGISTRY_SIM_PORT=4000
# Cheia de acces la Registru. Serverul și simulatorul o citesc din .env.
REGISTRY_API_KEY=cheie-locala-doar-pentru-dezvoltare
