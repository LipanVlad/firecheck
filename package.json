{
  "name": "firecheck",
  "version": "0.1.0",
  "private": true,
  "description": "FireCheck — inspecții PSI de teren, cu funcționare offline și sincronizare",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "concurrently -n api,web,registru -c blue,green,magenta \"node --watch-path=server server/index.js\" \"vite\" \"node registry-sim/index.js\"",
    "build": "vite build",
    "start": "node server/index.js",
    "registry": "node registry-sim/index.js",
    "seed": "node server/seed.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "coverage": "c8 npm test",
    "demo:ext": "node scripts/ext-demo.js",
    "test:e2e": "npm run build && playwright test",
    "load": "node load/run.js",
    "load:fara-indexuri": "node load/run.js --no-indexes",
    "test:off-10min": "npm run build && node scripts/off-10min.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "joi": "^18.3.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-react": "^6.3.0",
    "artillery": "^2.0.34",
    "c8": "^12.0.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  }
}
